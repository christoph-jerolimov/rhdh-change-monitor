---
import { getEntry, render } from "astro:content";
import Base from "../layouts/Base.astro";
import { releases, sourceUrl, url } from "../lib/data";

const readme = (await getEntry("pages", "index"))!;
const { Content } = await render(readme);
// `next` (when it resolved to a prerelease) plus the four newest releases.
const available = releases().filter((r) => r.resolved);
const latest = [...available.filter((r) => r.rhdh === "next"), ...available.filter((r) => r.rhdh !== "next").slice(0, 4)];
---

<Base title="RHDH Change Monitor" source={sourceUrl(readme)}>
  <h2>Latest releases</h2>
  <ul class="cards">
    {
      latest.map((r) => (
        <li>
          <a class="card" href={url(`releases/${r.rhdh}`)}>
            <strong>RHDH {r.rhdh}</strong>
            <span>Backstage {r.resolved}</span>
          </a>
        </li>
      ))
    }
  </ul>
  <article class="markdown">
    <Content />
  </article>
</Base>
